    "name": "Features",
    "texts": [
      {
        "name": "Feature 1 title",
        "text": "TRANSPARENT FARM PRODUCTS COLLECTION & CONNECTIVITY THROUGH LUMBOX CONNECT",
        "font": "DM Mono",
        "weight": 500,
        "size": 28.0,
        "color": {
